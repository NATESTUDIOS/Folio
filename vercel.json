{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/app", "destination": "/index.html" },
    { "source": "/app/(.*)", "destination": "/index.html" },
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/settings", "destination": "/settings.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/invite", "destination": "/invite.html" },
    { "source": "/offline", "destination": "/offline.html" },
    { "source": "/p/:pid", "destination": "/api/host?action=share&pid=:pid" },
    { "source": "/:username/:project/:file", "destination": "/api/host?action=share&username=:username&project=:project&file=:file" },
    { "source": "/:username/:project", "destination": "/api/host?action=share&username=:username&project=:project" },
    { "source": "/:username", "destination": "/api/host?action=profile&username=:username" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    }
  ],
  "redirects": [
    { "source": "/", "destination": "/app", "permanent": false }
  ]
}